# Copy this file to .env and adjust for your machine.
# These are the variables the Go service reads (see dbConfig/init.go).
# The Makefile has the same defaults, so `make dev` works without a .env.

DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=eventer
DB_PORT=5432

# HTTP port for the API (wired through in a later change; currently 8080).
PORT=8080
