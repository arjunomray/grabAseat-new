# Copy this file to .env and adjust for your machine.
# The service loads .env automatically when present (see config/config.go).
# The Makefile supplies the same defaults, so `make dev` works without a .env.

DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=eventer
DB_PORT=5432

# HTTP port for the API.
PORT=8080

# Secret used to sign JWTs. Required; use a strong random value anywhere shared.
JWT_SECRET=dev-secret-change-me

# Comma-separated list of browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173
